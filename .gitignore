__pycache__/
*.pyc
.venv/
experiments/*.wav
experiments/prosody/
experiments/asr/
data/
# Eval results ARE tracked: they are the evidence behind the model choices in
# server/config.py, and a diff on them shows exactly what a change did to
# accuracy. ~700K of CSV, which is worth it. Only the regenerable and transient
# bits are ignored:
# ASR/SER compute cache, rebuilt on demand
eval/results/_cache_*.jsonl
# live progress, meaningless once a run ends
eval/results/*_status.json
eval/results/*_status.tmp
# throwaway smoke-test output, mixed seeds
eval/results/demo*
# older ad-hoc outputs at eval/ root
eval/*_results.csv

# --- secrets -----------------------------------------------------------------
# These all currently live OUTSIDE the repo by design -- the AUTH_TOKEN in
# ~/.emtext/ and the Cloudflare credentials in ~/.cloudflared/ -- specifically
# so a stray `git add -A` cannot publish them. These patterns are belt and
# braces for the day someone copies one in "just to test".
.emtext/
auth_token
*.pem
cert.pem
.cloudflared/
config.yml
*-credentials.json
# cloudflared writes tunnel creds as <uuid>.json
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*.json
.env
.env.*
